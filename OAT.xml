<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
             <policyitem type="compatibility" name="zlib-acknowledgement" path="libavutil.*" desc="" />
                <policyitem type="compatibility" name="zlib-acknowledgement" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPL-2.1+" path=".*" desc="" />
