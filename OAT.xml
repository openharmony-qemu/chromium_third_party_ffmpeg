                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Headers/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                 <filteritem type="filepath" name=".*h"
                    desc="" />
                <filteritem type="filepath" name="tests/ref/fate/source"
                    desc="" />
                <filteritem type="filepath" name="doc/git-howto.texi"
                    desc="" />
